# Original fresh SAO recipe; native per-batch packing switches to historical resume20 budgets at step21.
source "$REPO_ROOT/scripts/train/configs/sao_sync_1node_qwen35_9b_swesmith_b64_w32_v6d_20260930.env"
: "${ICPS_FORMAL_ROOT:?explicit isolated formal source root required}"
: "${ICPS_FORMAL_RUN_DIR:?explicit unique attempt required}"
EXP_NAME=sao-qwen35-9b-b64-icps-v11-192-full97-r2-20261024
TRAINER_EXPERIMENT_NAME=$EXP_NAME
TRAINER_RESUME_MODE=disable
VERL_ENTRY_MODULE=formal_main
TRAIN_FILES=/media/ubuntu/D1/zsj/Lego-RL-main/data/swesmith_python_full_v7_verdict_v6_20260930.parquet
HARBOR_LOG_DIR=$ICPS_FORMAL_RUN_DIR/harbor_logs
HARBOR_TRIALS_DIR=$ICPS_FORMAL_RUN_DIR/trials
TRAIN_LOG=$ICPS_FORMAL_RUN_DIR/train.log
VLLM_LOG=$ICPS_FORMAL_RUN_DIR/vllm.log
PYTHONPATH=$ICPS_FORMAL_ROOT/runtime:$ICPS_FORMAL_ROOT/src:$ICPS_FORMAL_ROOT/core:$PYTHONPATH
ICPS_V11_OVERLAY=1
ICPS_V11_ROOT=$ICPS_FORMAL_ROOT
ICPS_V11_ORIGINAL_SOURCE=$ICPS_FORMAL_ROOT/core
ICPS_V11_CACHED_IMAGES=$ICPS_FORMAL_ROOT/preflight/FULL6248_PREPARED_IMAGES.json
PI_ENABLE=1
PI_FORMAT=icps_window_v11
PI_MAX_TOKENS_PER_STATE=192
ICPS_EPISODE_PI_BUDGET=4096
PI_TOTAL_BUDGET_ENABLE=1
PI_CRITIC_MAX_SEQ_TOKENS=245760
PI_ACTOR_RESERVED_TOKENS=73728
PI_WARMUP_CHECKPOINT_STEPS=
PI_CHECKPOINT_STRICT=1
PI_MIN_CHECKPOINT_FREE_GIB=200
ICPS_V11_RELEASE_AUDIT=$ICPS_FORMAL_RUN_DIR/steps.jsonl
ICPS_V11_VIEW_AUDIT=$ICPS_FORMAL_RUN_DIR/view_hashes.jsonl
ICPS_V11_MICROBATCH_AUDIT=$ICPS_FORMAL_RUN_DIR/microbatches.jsonl
# Prepared tag verified against full6248 manifest, not the eight-task canary map.
HARBOR_ENVIRONMENT_FORCE_BUILD=False
HARBOR_ENVIRONMENT_DELETE=False
LEGO_EVAL_SUBNET_POOL=172.16.160.0/20
LEGO_EVAL_SUBNET_PREFIX=29
RAY_SCOPED_CLEANUP=1
RAY_PORT=6399
RAY_DASHBOARD_PORT=8299
RAY_ADDRESS=10.150.16.200:6399
TMPDIR=/tmp/icpsfull97r2
TRITON_CACHE_DIR=$ICPS_FORMAL_RUN_DIR/cache/triton
TORCHINDUCTOR_CACHE_DIR=$ICPS_FORMAL_RUN_DIR/cache/inductor
# No TOTAL_EPOCHS/total_training_steps override: original full97-step horizon.
# Reuse native builder stages verbatim; append only supported output namespaces.
build_hydra_args() {
    init_hydra_args
    append_common_hydra_args
    append_engine_hydra_args
    append_critic_hydra_args
    append_mode_hydra_args
    add trainer.default_local_dir "$ICPS_CHECKPOINT_ROOT"
    add trainer.episode_log_dir "$ICPS_FORMAL_RUN_DIR/episode_logs"
    add hydra.run.dir "$ICPS_FORMAL_RUN_DIR/hydra"
}
