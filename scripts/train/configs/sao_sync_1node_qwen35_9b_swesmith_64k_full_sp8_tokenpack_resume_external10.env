# Resume the identical SAO training budget after an external Verified-500 run.
# A checkpoint watcher stops only at global steps 40, 50, ...; each complete
# Actor checkpoint is then evaluated with the original standalone 262K protocol
# before training is resumed. Disable the shorter-context in-trainer validation.
source "$REPO_ROOT/scripts/train/configs/sao_sync_1node_qwen35_9b_swesmith_64k_full_sp8_tokenpack_resume10.env"
TRAINER_TEST_FREQ=0
