# Fresh base-model experiment. Never reuse the prior run's checkpoint directory.
source "$REPO_ROOT/scripts/train/configs/sao_sync_1node_qwen35_9b_swesmith_64k_full_sp8_tokenpack.env"
PROJECT_NAME=sao-qwen35-9b-swesmith
EXP_NAME=sao-qwen35-9b-swesmith-b64-w32-v6-20260930
HARBOR_LOG_DIR=$REPO_ROOT/logs/$PROJECT_NAME/$EXP_NAME
HARBOR_TRIALS_DIR=$REPO_ROOT/harbor_trials/$PROJECT_NAME/$EXP_NAME
TRAIN_LOG=$REPO_ROOT/logs/sao_b64_w32_v6_20260930b_train.log
VLLM_LOG=$REPO_ROOT/logs/sao_b64_w32_v6_20260930b_vllm.log
TRAIN_FILES=$REPO_ROOT/data/swesmith_python_full_v7_verdict_v6_20260930.parquet
TRAIN_BSZ=64
TRAIN_PROMPT_BSZ=64
TRAIN_MINI_BSZ=64
ACTOR_PPO_MINI_BATCH_SIZE=64
CRITIC_PPO_MINI_BATCH_SIZE=64
AGENT_NUM_WORKERS=32
TRAINER_SAVE_FREQ=10
TRAINER_TEST_FREQ=0
TRAINER_VAL_BEFORE_TRAIN=False
# User: retain all NEW checkpoints; warn before space is insufficient.
MAX_ACTOR_CKPT_TO_KEEP=1000
MAX_CRITIC_CKPT_TO_KEEP=1000
# Preserve optimizer/math/token budgets, including 20 critic-only warmup steps.
CRITIC_WARMUP=20
# Explicit per-trial networks; no shared Docker daemon reconfiguration.
HARBOR_ENVIRONMENT_IMPORT_PATH=harbor_patch.environments.pooled_remote_docker:PooledRemoteDockerEnvironment
LEGO_EVAL_SUBNET_POOL=172.16.240.0/20
LEGO_EVAL_SUBNET_PREFIX=29
# Large compile caches and Python temporary files stay on D1.
TMPDIR=/tmp/lego-b64-v6
# TMPDIR is a verified short symlink into D1, needed by Unix socket paths.
# Join the launcher's checked single-node head instead of auto-starting a head.
RAY_ADDRESS=10.150.16.200:6379
TRITON_CACHE_DIR=$REPO_ROOT/.cache/triton_b64_w32_v6_20260930
TORCHINDUCTOR_CACHE_DIR=$REPO_ROOT/.cache/inductor_b64_w32_v6_20260930
