# Single-node end-to-end SAO plumbing smoke for dense Qwen3.5-9B.
#
# Launch through /home/ubuntu/.local/bin/lego-cuda12-run on the A800 host.  The
# wrapper selects CUDA 12.8 forward-compat libcuda and NCCL 2.27.5, avoiding the
# colliding cu13 NCCL package present in this venv.
#
# This is deliberately one task, one response, and no validation/checkpoint. It
# proves rollout -> verifier reward -> dense Qwen3.5 critic values -> GAE ->
# critic update -> SAO/DIS actor update. It is not a learning or baseline run.

# --- template selection -----------------------------------------------
BACKEND=docker
SCAFFOLD=ohsdk
TRAINING_MODE=sync
MODEL_ENGINE=veomni

# --- identity ----------------------------------------------------------
PROJECT_NAME=sao-qwen35-9b-local
EXP_NAME=sao-1node-qwen35-9b-docker-smoke-$(date +%Y%m%d-%H%M%S)

# --- runtime -----------------------------------------------------------
VENV_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/.venv
HARBOR_LOG_DIR=/media/ubuntu/D1/zsj/Lego-RL-main/logs/${PROJECT_NAME}/${EXP_NAME}
HARBOR_TRIALS_DIR=/media/ubuntu/D1/zsj/Lego-RL-main/harbor_trials/${PROJECT_NAME}/${EXP_NAME}
TRAINER_LOGGER="['console']"
WANDB_API_KEY="${WANDB_API_KEY:-}"
RAY_OBJECT_STORE_MEMORY=40000000000
TRAIN_NETWORK_INTERFACE=eno1

# --- model -------------------------------------------------------------
MODEL_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/Qwen3.5-9B
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder
# Cold critic: actor backbone plus a freshly initialized scalar score head.
CRITIC_MODEL_PATH=${MODEL_PATH}

# --- data --------------------------------------------------------------
TRAIN_FILES=/media/ubuntu/D1/zsj/Lego-RL-main/data/train_lego_rl_smoke_flask_annex_37.parquet
# Verl constructs the validation dataset even when validation is disabled.
VAL_FILES=/media/ubuntu/D1/zsj/Lego-RL-main/data/swebench_verified_smoke_sympy_20590.parquet

# --- single-host topology ---------------------------------------------
NNODES=1
NGPUS_PER_NODE=8
N_NODES_TRAIN=1
N_NODES_ROLLOUT=0

# --- cadence -----------------------------------------------------------
TOTAL_EPOCHS=1
TRAINER_VAL_BEFORE_TRAIN=False
TRAINER_TEST_FREQ=-1
TRAINER_SAVE_FREQ=-1

# --- Docker Harbor sandbox --------------------------------------------
AGENT_LOOP_CONFIG_PATH=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_oh_docker.yaml
# This smoke task is prepared as a local prebuilt image on the A800 host.
# Its task.toml points at lego-rl-train-cache/4catalyzer__flask-annex-37:latest.
HARBOR_ENVIRONMENT_FORCE_BUILD=False
# Keep the prebuilt image after the trial; `delete=True` maps to
# `docker compose down --rmi all` in Harbor and would erase the cache.
HARBOR_ENVIRONMENT_DELETE=False
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=2
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=8192
HARBOR_VERIFIER_RUNTIME_IMAGE=lego-rl/swebench-verifier-runtime:4.0.3-py311
HARBOR_VERIFIER_RUNTIME_MOUNT_PATH=/opt/lego-verifier
HARBOR_VERIFIER_RUNTIME_IMAGE_SUBPATH=opt/lego-verifier
HARBOR_VERIFIER_RUNTIME_REQUIRED=True
HARBOR_AGENT_MAX_ITERATIONS=10
HARBOR_AGENT_MAX_TIMEOUT_SEC=900
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=900
HARBOR_VAL_AGENT_MAX_TIMEOUT_SEC=900
AGENT_NUM_WORKERS=1

# --- model sizing ------------------------------------------------------
# One SP=8 training group and one TP=8 rollout engine use all eight GPUs. vLLM
# sleeps while actor/critic update; VeOmni offloads parameters and optimizer.
SP_SIZE=8
EP_SIZE=1
GEN_TP=8
ENABLE_SLEEP_MODE=True
# Every sample in this SWE-bench run is text-only.  This explicit guard lets
# the patched Qwen3.5 wrapper skip FSDP's multimodal dummy forward on the actor
# as well as the critic; it does not affect real image/video batches when unset.
VEOMNI_QWEN35_TEXT_ONLY=1
GPU_MEM_UTIL=0.55
MAX_PROMPT=8192
MAX_RESP=8192
USE_DYNAMIC_BSZ=True
CRITIC_USE_DYNAMIC_BSZ=True
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=2560
CRITIC_PPO_MAX_TOKEN_LEN_PER_GPU=2560
TRAIN_BSZ=1
TRAIN_MINI_BSZ=1
TRAIN_PROMPT_BSZ=1
VAL_BSZ=1
# Dense model: no expert routing replay or expert parallelism.
ENABLE_R3=False
VLLM_ENABLE_EXPERT_PARALLEL=False

# --- SAO ---------------------------------------------------------------
# Plumbing smoke: update actor immediately so the DIS path is exercised.
# A real cold-critic run should use 10-20 critic-only warmup steps.
CRITIC_WARMUP=0
CRITIC_FREEZE_PARAM_PATTERNS='[self_attn.,linear_attn.,visual.]'

# SAO must precede common.env because template defaults use first assignment.
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/sao.env
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
