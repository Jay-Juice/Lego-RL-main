# Isolated SP4/DP2 trial; share immutable captured input, never production weights.
source "$REPO_ROOT/scripts/train/configs/sao_token_benchmark_20261001.env"
SP_SIZE=4
LEGO_TOKEN_BENCH_ROOT=$REPO_ROOT/logs/token_budget_benchmark_sp4_20261001
EXP_NAME=token-bench-sp4-${LEGO_TOKEN_BENCH_MODE}-c${CRITIC_PPO_MAX_TOKEN_LEN_PER_GPU}-a${ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU}-20261001
HARBOR_LOG_DIR=$LEGO_TOKEN_BENCH_ROOT/$EXP_NAME
HARBOR_TRIALS_DIR=$REPO_ROOT/harbor_trials/$PROJECT_NAME/$EXP_NAME
TRAIN_LOG=$LEGO_TOKEN_BENCH_ROOT/${EXP_NAME}_train.log
VLLM_LOG=$LEGO_TOKEN_BENCH_ROOT/${EXP_NAME}_vllm.log
