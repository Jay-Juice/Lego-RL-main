source "$REPO_ROOT/scripts/train/configs/pi_v2_resume_diagnostic_20261015.env"
TRAIN_LOG=$REPO_ROOT/logs/resume_diagnostic_v2_r3_train.log
VLLM_LOG=$REPO_ROOT/logs/resume_diagnostic_v2_r3_vllm.log
export PI_DIAGNOSTIC_DIR=$REPO_ROOT/logs/resume_diagnostic_v2_r3_20261015/results
# Validation-only FA backward determinism; never inherited by formal training.
export FLASH_ATTENTION_DETERMINISTIC=1
export PI_DIAGNOSTIC_FULL_HASH=1
export PI_DIAGNOSTIC_REQUIRE_REPEAT=1
