# Baseline learning recipe: no head initialization, freeze, LR or loss override.
source "$REPO_ROOT/scripts/train/configs/sao_b64_pi_structural_delta_v1_r4_20261006.env"
EXP_NAME=sao-qwen35-9b-b64-pi-repair-state-v2-20261015
TRAINER_EXPERIMENT_NAME=$EXP_NAME
export PI_ATTEMPT_ID=${PI_ATTEMPT_ID:-$(date -u +%Y%m%dT%H%M%S)-$$}
HARBOR_LOG_DIR=$REPO_ROOT/logs/$EXP_NAME/$PI_ATTEMPT_ID
HARBOR_TRIALS_DIR=$REPO_ROOT/harbor_trials/$EXP_NAME/$PI_ATTEMPT_ID
TRAIN_LOG=$REPO_ROOT/logs/train_pi_repair_state_v2_${PI_ATTEMPT_ID}.log
VLLM_LOG=$REPO_ROOT/logs/vllm_pi_repair_state_v2_${PI_ATTEMPT_ID}.log
export PI_FORMAT=repair_state_v2
export PI_MAX_TOKENS_PER_STATE=2048
export PI_TOTAL_BUDGET_ENABLE=1
export PI_CRITIC_MAX_SEQ_TOKENS=245760
export PI_ACTOR_RESERVED_TOKENS=73728
# User reverted warmup persistence: match baseline first save at20.
export PI_WARMUP_CHECKPOINT_STEPS=
export PI_CHECKPOINT_STRICT=1
# Formal start requires a separate explicit launch; auto-resume never falls back.
TRAINER_RESUME_MODE=${PI_RESUME_MODE:-disable}

export PI_BATCH_AUDIT_DIR=$REPO_ROOT/logs/$EXP_NAME/$PI_ATTEMPT_ID/pi_batches
