# Single-node plumbing smoke for SAO on Qwen3.5-35B-A3B.
#
# This deliberately runs one training task, one response, and no validation. It
# checks the local Docker sandbox, Qwen3.5 MoE/R3 path, critic, rollout, and actor
# update on one 8xA800-80GB host. It is not the author's 3-node production run.

# --- template selection -----------------------------------------------
BACKEND=docker
SCAFFOLD=ohsdk
TRAINING_MODE=sync
MODEL_ENGINE=veomni

# --- identity ----------------------------------------------------------
PROJECT_NAME=sao-qwen35a3b-local
EXP_NAME=sao-1node-qwen35a3b-docker-smoke

# --- runtime -----------------------------------------------------------
VENV_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/.venv
HARBOR_LOG_DIR=/media/ubuntu/D1/zsj/Lego-RL-main/logs/${PROJECT_NAME}/${EXP_NAME}
HARBOR_TRIALS_DIR=/media/ubuntu/D1/zsj/Lego-RL-main/harbor_trials/${PROJECT_NAME}/${EXP_NAME}
TRAINER_LOGGER="['console']"
WANDB_API_KEY="${WANDB_API_KEY:-}"
RAY_OBJECT_STORE_MEMORY=40000000000
TRAIN_NETWORK_INTERFACE=eno1

# --- model -------------------------------------------------------------
MODEL_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/Qwen3.5-35B-A3B
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder
# Cold critic: the backbone starts from the actor checkpoint and the value head
# starts random. A future baseline run should use a merged warm critic if one is
# available.
CRITIC_MODEL_PATH=${MODEL_PATH}

# --- data --------------------------------------------------------------
TRAIN_FILES=/media/ubuntu/D1/zsj/Lego-RL-main/data/train_lego_rl_smoke_flask_annex_37.parquet
# Verl constructs the validation dataset even with validation disabled.
VAL_FILES=/media/ubuntu/D1/zsj/Lego-RL-main/data/swebench_verified_smoke_sympy_20590.parquet

# --- single-host topology ---------------------------------------------
NNODES=1
NGPUS_PER_NODE=8
N_NODES_TRAIN=1
N_NODES_ROLLOUT=0

# --- cadence -----------------------------------------------------------
TOTAL_EPOCHS=1
TRAINER_VAL_BEFORE_TRAIN=False
TRAINER_TEST_FREQ=-1
TRAINER_SAVE_FREQ=-1

# --- Docker Harbor sandbox --------------------------------------------
# Docker uses the dedicated RemoteDockerEnvironment agent loop. The selected
# training image has already been built; force_build therefore reuses its layers.
AGENT_LOOP_CONFIG_PATH=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_oh_docker.yaml
HARBOR_ENVIRONMENT_FORCE_BUILD=True
HARBOR_ENVIRONMENT_DELETE=True
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=2
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=8192
HARBOR_VERIFIER_RUNTIME_IMAGE=lego-rl/swebench-verifier-runtime:4.0.3-py311
HARBOR_AGENT_MAX_ITERATIONS=10
HARBOR_AGENT_MAX_TIMEOUT_SEC=900
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=900
HARBOR_VAL_AGENT_MAX_TIMEOUT_SEC=900
AGENT_NUM_WORKERS=1

# --- model sizing ------------------------------------------------------
# One SP=8 training group and one TP=8 vLLM engine use all eight GPUs. vLLM
# sleeps while the actor and critic update; all model and optimizer states use
# CPU offload through the VeOmni defaults.
SP_SIZE=8
EP_SIZE=1
GEN_TP=8
ENABLE_SLEEP_MODE=True
GPU_MEM_UTIL=0.55
MAX_PROMPT=8192
MAX_RESP=8192
USE_DYNAMIC_BSZ=True
CRITIC_USE_DYNAMIC_BSZ=True
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=2560
CRITIC_PPO_MAX_TOKEN_LEN_PER_GPU=2560
TRAIN_BSZ=1
TRAIN_MINI_BSZ=1
TRAIN_PROMPT_BSZ=1
VAL_BSZ=1
ENABLE_R3=True
VLLM_ENABLE_EXPERT_PARALLEL=True

# --- SAO ---------------------------------------------------------------
CRITIC_WARMUP=1
CRITIC_FREEZE_PARAM_PATTERNS='[self_attn.,linear_attn.,visual.]'

# SAO must precede common.env because template defaults use first assignment.
TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/sao.env
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
