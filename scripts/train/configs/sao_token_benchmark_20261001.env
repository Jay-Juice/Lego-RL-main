# Isolated token-budget benchmark: no production updates or checkpoint writes.
source "$REPO_ROOT/scripts/train/configs/sao_sync_1node_qwen35_9b_swesmith_b64_w32_v6d_20260930.env"
VERL_ENTRY_MODULE=verl_patch.token_budget_benchmark
LEGO_TOKEN_BENCH_MODE=${LEGO_TOKEN_BENCH_MODE:-capture}
LEGO_TOKEN_BENCH_SINGLE=${LEGO_TOKEN_BENCH_SINGLE:-0}
LEGO_TOKEN_BENCH_ROOT=$REPO_ROOT/logs/token_budget_benchmark_20261001
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=${BENCH_ACTOR_TOKENS:-14336}
CRITIC_PPO_MAX_TOKEN_LEN_PER_GPU=${BENCH_CRITIC_TOKENS:-20480}
EXP_NAME=token-bench-${LEGO_TOKEN_BENCH_MODE}-c${CRITIC_PPO_MAX_TOKEN_LEN_PER_GPU}-a${ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU}-20261001
HARBOR_LOG_DIR=$LEGO_TOKEN_BENCH_ROOT/$EXP_NAME
HARBOR_TRIALS_DIR=$REPO_ROOT/harbor_trials/$PROJECT_NAME/$EXP_NAME
TRAIN_LOG=$LEGO_TOKEN_BENCH_ROOT/${EXP_NAME}_train.log
VLLM_LOG=$LEGO_TOKEN_BENCH_ROOT/${EXP_NAME}_vllm.log
