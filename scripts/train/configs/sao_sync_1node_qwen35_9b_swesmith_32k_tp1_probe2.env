# Two-step Qwen3.5-9B SAO throughput probe for single-GPU rollout replicas.
#
# The five-task canary set is consumed twice as two batches of five.  GEN_TP=1
# lets verl form independent single-GPU vLLM replicas; five concurrent agents
# exercise five replicas while the actor/critic still train with SP=8.  Sampling
# matches the Lego-RL author's training defaults rather than the earlier
# Agent-Lightning/Qwen non-thinking preset used by the first canaries.

BACKEND=docker
SCAFFOLD=ohsdk
TRAINING_MODE=sync
MODEL_ENGINE=veomni

PROJECT_NAME=sao-qwen35-9b-swesmith
EXP_NAME=sao-qwen35-9b-swesmith-32k-tp1-probe2-$(date +%Y%m%d-%H%M%S)

VENV_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/.venv
HARBOR_LOG_DIR=/media/ubuntu/D1/zsj/Lego-RL-main/logs/${PROJECT_NAME}/${EXP_NAME}
HARBOR_TRIALS_DIR=/media/ubuntu/D1/zsj/Lego-RL-main/harbor_trials/${PROJECT_NAME}/${EXP_NAME}
TRAINER_LOGGER="['console']"
WANDB_API_KEY="${WANDB_API_KEY:-}"
RAY_OBJECT_STORE_MEMORY=40000000000
TRAIN_NETWORK_INTERFACE=eno1

MODEL_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/Qwen3.5-9B
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder
CRITIC_MODEL_PATH=${MODEL_PATH}

TRAIN_FILES=/media/ubuntu/D1/zsj/Lego-RL-main/data/swesmith_python_full_v7_canary5.parquet
VAL_FILES=/media/ubuntu/D1/zsj/Lego-RL-main/data/swesmith_python_full_v7_smoke1.parquet

NNODES=1
NGPUS_PER_NODE=8
N_NODES_TRAIN=1
N_NODES_ROLLOUT=0

# Five examples per batch x two epochs = two optimizer steps.
TOTAL_EPOCHS=2
TRAINER_VAL_BEFORE_TRAIN=False
TRAINER_TEST_FREQ=-1
TRAINER_SAVE_FREQ=-1

AGENT_LOOP_CONFIG_PATH=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_oh_docker.yaml
HARBOR_ENVIRONMENT_FORCE_BUILD=False
HARBOR_ENVIRONMENT_DELETE=False
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=2
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=8192
HARBOR_VERIFIER_RUNTIME_IMAGE=lego-rl/swebench-verifier-runtime:4.0.3-py311
HARBOR_VERIFIER_RUNTIME_MOUNT_PATH=/opt/lego-verifier
HARBOR_VERIFIER_RUNTIME_IMAGE_SUBPATH=opt/lego-verifier
HARBOR_VERIFIER_RUNTIME_REQUIRED=True
HARBOR_AGENT_MAX_ITERATIONS=32
HARBOR_AGENT_MAX_TIMEOUT_SEC=1800
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=1800
HARBOR_VAL_AGENT_MAX_TIMEOUT_SEC=1800
AGENT_NUM_WORKERS=5

SP_SIZE=8
EP_SIZE=1
GEN_TP=1
ENABLE_SLEEP_MODE=True
VEOMNI_QWEN35_TEXT_ONLY=1
GPU_MEM_UTIL=0.55
ROLLOUT_MAX_MODEL_LEN=65536
MAX_PROMPT=8192
MAX_RESP=32768
USE_DYNAMIC_BSZ=True
CRITIC_USE_DYNAMIC_BSZ=True
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=5632
CRITIC_PPO_MAX_TOKEN_LEN_PER_GPU=5632
TRAIN_BSZ=5
TRAIN_MINI_BSZ=5
TRAIN_PROMPT_BSZ=5
VAL_BSZ=1
ENABLE_R3=False
VLLM_ENABLE_EXPERT_PARALLEL=False

# Match the Lego-RL author's training sampling defaults.
TEMPERATURE=1.0
TOP_P=1.0
TOP_K=-1
VAL_TEMPERATURE=0.7
VAL_TOP_P=1.0
VAL_TOP_K=-1

# Step 1 is critic-only; step 2 also exercises actor update and TP=1 weight sync.
CRITIC_WARMUP=2
CRITIC_FREEZE_PARAM_PATTERNS='[self_attn.,linear_attn.,visual.]'

TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/sao.env
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
