# Independent fresh-base PI-SAO run. The original production config is copied, not edited.
source "$REPO_ROOT/scripts/train/configs/sao_b64_resume20_tokens_20261001.env"
BASELINE_ROOT=/media/ubuntu/D1/zsj/Lego-RL-main
EXP_NAME=sao-qwen35-9b-b64-pi-structural-delta-v1-20261006
TRAINER_EXPERIMENT_NAME=$EXP_NAME
TRAIN_FILES=$BASELINE_ROOT/data/swesmith_python_full_v7_verdict_v6_20260930.parquet
HARBOR_LOG_DIR=$REPO_ROOT/logs/$EXP_NAME
HARBOR_TRIALS_DIR=$REPO_ROOT/harbor_trials/$EXP_NAME
TRAIN_LOG=$REPO_ROOT/logs/train.log
VLLM_LOG=$REPO_ROOT/logs/vllm.log
TMPDIR=/tmp/lpi26
TRITON_CACHE_DIR=$REPO_ROOT/.cache/triton
TORCHINDUCTOR_CACHE_DIR=$REPO_ROOT/.cache/inductor
RAY_SCOPED_CLEANUP=1
PYTHONPATH=$REPO_ROOT/src:$REPO_ROOT/third_party/verl:$REPO_ROOT/third_party/harbor/src:$REPO_ROOT
PYTHONDONTWRITEBYTECODE=1
PI_ENABLE=1
PI_MAX_TOKENS_PER_STATE=1024
PI_DIFF_CONTEXT_LINES=20
PI_MIN_CHECKPOINT_FREE_GIB=200
# Explicitly exclude old experiment recovery; fresh base reproduces the earlier bsz64 start.
TRAINER_RESUME_MODE=disable
