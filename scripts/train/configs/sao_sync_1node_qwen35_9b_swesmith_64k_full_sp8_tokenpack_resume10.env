# Resume-only variant for the same experiment; use after verifying a complete checkpoint.
# At global steps 30, 40, 50, ... save, then validate all 500 SWE-bench
# Verified tasks inside the trainer before continuing the next training step.
# Native verl retention counts only checkpoints saved by the current process.
# Keep its internal limit above this run's 39 remaining saves; the scoped
# rotation watcher enforces three total across the step20/25 resume boundary.
# Full-epoch SP8/DP1 SAO with dynamic token packing and scoped Ray cleanup.
#
# The offline-compatible conversion contains 6,242 tasks. GEN_TP=1 runs one
# rollout replica per A800; actor and critic training remain SP=8. Sampling
# matches the Lego-RL author's training defaults.

BACKEND=docker
SCAFFOLD=ohsdk
TRAINING_MODE=sync
MODEL_ENGINE=veomni

PROJECT_NAME=sao-qwen35-9b-swesmith
EXP_NAME=sao-qwen35-9b-swesmith-64k-full-sp8-tokenpack-v1

VENV_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/.venv
HARBOR_LOG_DIR=/media/ubuntu/D1/zsj/Lego-RL-main/logs/${PROJECT_NAME}/${EXP_NAME}
HARBOR_TRIALS_DIR=/media/ubuntu/D1/zsj/Lego-RL-main/harbor_trials/${PROJECT_NAME}/${EXP_NAME}
TRAINER_LOGGER="['console']"
WANDB_API_KEY="${WANDB_API_KEY:-}"
RAY_OBJECT_STORE_MEMORY=40000000000
TRAIN_NETWORK_INTERFACE=eno1
RAY_SCOPED_CLEANUP=1

MODEL_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/Qwen3.5-9B
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder
CRITIC_MODEL_PATH=${MODEL_PATH}

TRAIN_FILES=/media/ubuntu/D1/zsj/Lego-RL-main/data/swesmith_python_full_v7_all6248.parquet
VAL_FILES=/media/ubuntu/D1/zsj/Lego-RL-main/data/swebench_verified_index.parquet
TRAINER_VALIDATION_DATA_DIR=/media/ubuntu/D1/zsj/Lego-RL-main/logs/sao_verified500_intrain/resume25_20260925

NNODES=1
NGPUS_PER_NODE=8
N_NODES_TRAIN=1
N_NODES_ROLLOUT=0

# 6,242 compatible tasks across one epoch; keep the same 16-trial step budget.
TOTAL_EPOCHS=1
TRAINER_VAL_BEFORE_TRAIN=False
TRAINER_TEST_FREQ=10
TRAINER_SAVE_FREQ=10
MAX_ACTOR_CKPT_TO_KEEP=100
MAX_CRITIC_CKPT_TO_KEEP=100

AGENT_LOOP_CONFIG_PATH=${REPO_ROOT}/src/verl_patch/config/agent_loop_config_oh_docker.yaml
HARBOR_ENVIRONMENT_FORCE_BUILD=True
HARBOR_ENVIRONMENT_DELETE=False
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=4
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=8192
HARBOR_VERIFIER_RUNTIME_IMAGE=lego-rl/swebench-verifier-runtime:4.0.3-py311
HARBOR_VERIFIER_RUNTIME_MOUNT_PATH=/opt/lego-verifier
HARBOR_VERIFIER_RUNTIME_IMAGE_SUBPATH=opt/lego-verifier
HARBOR_VERIFIER_RUNTIME_REQUIRED=True
HARBOR_AGENT_MAX_ITERATIONS=128
HARBOR_AGENT_MAX_TIMEOUT_SEC=3600
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=3600
HARBOR_VAL_AGENT_MAX_ITERATIONS=200
HARBOR_VAL_AGENT_MAX_TIMEOUT_SEC=7200
HARBOR_VAL_AGENT_OVERRIDE_TIMEOUT_SEC=7200
HARBOR_VAL_VERIFIER_TIMEOUT_MULTIPLIER=2.0
HARBOR_VAL_MAX_RETRIES=1
HARBOR_VAL_ENVIRONMENT_FORCE_BUILD=False
HARBOR_VAL_ENVIRONMENT_DELETE=True
HARBOR_VAL_ENVIRONMENT_OVERRIDE_CPUS=2
# This Verified task timed out twice at 2 CPU; the saved step20 patch passed
# all 80 tests when reverified with 8 CPU. Limit the exception to that task.
HARBOR_VAL_HIGH_CPU_TASK_IDS=scikit-learn__scikit-learn-14710
HARBOR_VAL_HIGH_CPU_COUNT=8
AGENT_NUM_WORKERS=16

SP_SIZE=8
EP_SIZE=1
GEN_TP=1
ENABLE_SLEEP_MODE=True
VEOMNI_QWEN35_TEXT_ONLY=1
GPU_MEM_UTIL=0.55
ROLLOUT_MAX_MODEL_LEN=98304
MAX_PROMPT=8192
MAX_RESP=65536
USE_DYNAMIC_BSZ=True
CRITIC_USE_DYNAMIC_BSZ=True
ACTOR_PPO_MAX_TOKEN_LEN_PER_GPU=14336
CRITIC_PPO_MAX_TOKEN_LEN_PER_GPU=20480
TRAIN_BSZ=16
TRAIN_MINI_BSZ=16
TRAIN_PROMPT_BSZ=16
VAL_BSZ=16
VAL_SHUFFLE=False
ENABLE_R3=False
VLLM_ENABLE_EXPERT_PARALLEL=False

# Match the Lego-RL author's training sampling defaults.
TEMPERATURE=1.0
TOP_P=1.0
TOP_K=-1
VAL_TEMPERATURE=0.7
VAL_TOP_P=1.0
VAL_TOP_K=-1

# Cold critic warmup before Actor updates.
CRITIC_WARMUP=20
CRITIC_FREEZE_PARAM_PATTERNS='[self_attn.,linear_attn.,visual.]'

# Colocated vLLM needs these states offloaded before its post-update wake-up.
ACTOR_VEOMNI_PARAM_OFFLOAD=True
ACTOR_VEOMNI_OPTIMIZER_OFFLOAD=True
CRITIC_VEOMNI_PARAM_OFFLOAD=True
CRITIC_VEOMNI_OPTIMIZER_OFFLOAD=True

TEMPLATE_MODULES=(
  runtime/process.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
  verl/sao.env
  verl/common.env
  "verl/${TRAINING_MODE}.env"
  "verl/${MODEL_ENGINE}.env"
)
