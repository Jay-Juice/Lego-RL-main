# One of eight deterministic SWE-bench Verified shards. Launch through
# scripts/eval/run_qwen35_9b_verified_8gpu.sh, which assigns one shard and one
# independent single-GPU vLLM server to each A800.

BACKEND=docker
SCAFFOLD=ohsdk

: "${FULL_RUN_ID:?FULL_RUN_ID is required}"
: "${SHARD_ID:?SHARD_ID is required}"
: "${CUDA_VISIBLE_DEVICES:?CUDA_VISIBLE_DEVICES is required}"

PROJECT_NAME=eval-qwen35-9b-verified-full
EXP_NAME=eval-qwen35-9b-verified-full-${FULL_RUN_ID}-s${SHARD_ID}
POD_PREFIX=q359f${SHARD_ID}
STEP_TAG=full

VENV_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/.venv
TRAIN_NETWORK_INTERFACE=eno1
GLOO_SOCKET_IFNAME=eno1
TP_SOCKET_IFNAME=eno1
NCCL_SOCKET_IFNAME=eno1

MODEL_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/Qwen3.5-9B
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder

DATASET_PATH=${VERIFIED_SHARDS_ROOT:-/media/ubuntu/D1/zsj/Lego-RL-main/data/swebench-verified-shards-8}/shard_${SHARD_ID}
N_TASKS=

# One independent model replica per physical GPU. Scoped cleanup prevents one
# shard from terminating another shard's vLLM process.
N_CONCURRENT="${N_CONCURRENT:-8}"
MAX_RETRIES=1
EVAL_TEMPERATURE=0.7
MAX_INPUT_TOKENS=200000
MAX_OUTPUT_TOKENS=32768
MAX_MODEL_LEN=262144
GEN_TP=1
GPU_MEM_UTIL=0.95
VLLM_PORT=$((18000 + SHARD_ID))
# vLLM uses the VLLM_PORT environment variable as the start of a private
# multi-port allocation even when --port is supplied explicitly.  Give every
# shard a disjoint internal range so concurrent startup cannot choose the same
# torch.distributed rendezvous port.
VLLM_INTERNAL_PORT_START=$((20000 + SHARD_ID * 20))
VLLM_DP_MASTER_PORT=$((19000 + SHARD_ID * 20))
EVAL_SCOPED_VLLM_CLEANUP=True
EVAL_ENABLE_EXPERT_PARALLEL=false
EVAL_VLLM_EXTRA_ARGS="--enable-chunked-prefill --enable-prefix-caching --dtype bfloat16 --language-model-only --enforce-eager"
EVAL_VLLM_READY_ITERS=120

HARBOR_ENVIRONMENT_FORCE_BUILD=False
HARBOR_ENVIRONMENT_IMPORT_PATH=harbor_patch.environments.remote_docker:RemoteDockerEnvironment
HARBOR_ENVIRONMENT_DELETE=True
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=2
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=8192
HARBOR_AGENT_MAX_ITERATIONS=200
HARBOR_AGENT_MAX_TIMEOUT_SEC=7200
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=7200
HARBOR_AGENT_SETUP_TIMEOUT_MULTIPLIER=5.0
HARBOR_VERIFIER_TIMEOUT_MULTIPLIER=2.0
HARBOR_ENVIRONMENT_BUILD_TIMEOUT_MULTIPLIER=2.0
HARBOR_VERIFIER_ENABLED=True

HARBOR_VERIFIER_RUNTIME_IMAGE=lego-rl/swebench-verifier-runtime:4.0.3-py311
HARBOR_VERIFIER_RUNTIME_MOUNT_PATH=/opt/lego-verifier
HARBOR_VERIFIER_RUNTIME_IMAGE_SUBPATH=opt/lego-verifier
HARBOR_VERIFIER_RUNTIME_REQUIRED=True

TEMPLATE_MODULES=(
  runtime/process.env
  eval/common.env
  eval/vllm.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
