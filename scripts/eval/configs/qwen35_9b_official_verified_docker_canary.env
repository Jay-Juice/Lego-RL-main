# Qwen3.5-9B baseline on a deterministic prefix of SWE-bench Verified.
# Override N_TASKS=500 after the canary establishes stable throughput.

BACKEND=docker
SCAFFOLD=ohsdk

PROJECT_NAME=eval-qwen35-9b-verified
EXP_NAME=eval-qwen35-9b-verified-canary-$(date +%Y%m%d-%H%M%S)
POD_PREFIX=q359v
STEP_TAG=baseline

VENV_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/.venv
TRAIN_NETWORK_INTERFACE=eno1
GLOO_SOCKET_IFNAME=eno1
TP_SOCKET_IFNAME=eno1
NCCL_SOCKET_IFNAME=eno1

MODEL_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/Qwen3.5-9B
SERVED_MODEL_NAME=vllm_model
TOOL_CALL_PARSER=qwen3_coder

DATASET_PATH=/media/ubuntu/D1/zsj/Lego-RL-main/data/swebench-verified
N_TASKS="${N_TASKS:-20}"

# Run the canary on one GPU. The server's 550 driver supports CUDA 12.4, while
# this environment's PyTorch/NCCL build targets CUDA 12.8 and cannot initialize
# multi-GPU NCCL. Single-GPU serving has already passed the model smoke test.
N_CONCURRENT="${N_CONCURRENT:-16}"
MAX_RETRIES=1
EVAL_TEMPERATURE=0.7
MAX_INPUT_TOKENS=200000
MAX_OUTPUT_TOKENS=32768
MAX_MODEL_LEN=262144
GEN_TP=1
GPU_MEM_UTIL=0.95
VLLM_PORT=18000
EVAL_ENABLE_EXPERT_PARALLEL=false
EVAL_VLLM_EXTRA_ARGS="--enable-chunked-prefill --enable-prefix-caching --dtype bfloat16 --language-model-only --enforce-eager"
EVAL_VLLM_READY_ITERS=120

HARBOR_ENVIRONMENT_FORCE_BUILD=True
HARBOR_ENVIRONMENT_IMPORT_PATH=harbor_patch.environments.remote_docker:RemoteDockerEnvironment
HARBOR_ENVIRONMENT_DELETE=True
HARBOR_ENVIRONMENT_OVERRIDE_CPUS=2
HARBOR_ENVIRONMENT_OVERRIDE_MEMORY_MB=8192
HARBOR_AGENT_MAX_ITERATIONS=200
HARBOR_AGENT_MAX_TIMEOUT_SEC=7200
HARBOR_AGENT_OVERRIDE_TIMEOUT_SEC=7200
HARBOR_AGENT_SETUP_TIMEOUT_MULTIPLIER=5.0
HARBOR_VERIFIER_TIMEOUT_MULTIPLIER=2.0
HARBOR_ENVIRONMENT_BUILD_TIMEOUT_MULTIPLIER=2.0
HARBOR_VERIFIER_ENABLED=True

HARBOR_VERIFIER_RUNTIME_IMAGE=lego-rl/swebench-verifier-runtime:4.0.3-py311
HARBOR_VERIFIER_RUNTIME_MOUNT_PATH=/opt/lego-verifier
HARBOR_VERIFIER_RUNTIME_IMAGE_SUBPATH=opt/lego-verifier
HARBOR_VERIFIER_RUNTIME_REQUIRED=True

TEMPLATE_MODULES=(
  runtime/process.env
  eval/common.env
  eval/vllm.env
  "backend/${BACKEND}.env"
  harbor/common.env
  "scaffold/${SCAFFOLD}.env"
)
